---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const getPath = (path: string) => `/${path}/`;
---

<footer class="bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800 pt-16 pb-8 mt-auto">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center text-white font-bold text-xl">
            S
          </div>
          <span class="font-bold text-xl text-gray-900 dark:text-white">SaveFileTool</span>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed max-w-sm">
          {t('footer.desc')}
        </p>
      </div>

      <div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-4">{t('footer.editors')}</h4>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href={getPath('editor/rpg-maker-mv')} class="hover:text-primary-600 transition-colors">RPG Maker</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-4">{t('footer.resources')}</h4>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href={getPath('faq')} class="hover:text-primary-600 transition-colors">{t('footer.faq')}</a></li>
          <li><a href={getPath('support')} class="hover:text-primary-600 transition-colors">{t('nav.support')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-gray-900 dark:text-white mb-4">{t('footer.legal')}</h4>
        <ul class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <li><a href={getPath('about')} class="hover:text-primary-600 transition-colors">{t('nav.about')}</a></li>
          <li><a href={getPath('contact')} class="hover:text-primary-600 transition-colors">{t('nav.contact')}</a></li>
          <li><a href={getPath('privacy')} class="hover:text-primary-600 transition-colors">{t('footer.privacy')}</a></li>
          <li><a href={getPath('terms')} class="hover:text-primary-600 transition-colors">{t('footer.terms')}</a></li>
          <li><a href={getPath('cookie-policy')} class="hover:text-primary-600 transition-colors">{t('footer.cookie')}</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-100 dark:border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        &copy; {currentYear} SaveFileTool. All rights reserved.
      </p>
      <a href="mailto:support@savefiletool.com" class="text-sm text-gray-500 hover:text-primary-600 transition-colors">
        support@savefiletool.com
      </a>
    </div>
  </div>
</footer>
