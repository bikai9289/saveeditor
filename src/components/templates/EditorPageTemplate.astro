---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorApp from '../../components/EditorApp';
import { localizePath, useTranslations, type SiteLang } from '../../i18n/utils';
import { absoluteUrl, getSiteOrigin } from '../../lib/site';

interface EngineData {
  slug: string;
  name: string;
  fileType: string;
  title: string;
  description: string;
  keywords: string;
  features: string[];
  instructions: string[];
}

interface Props {
  engine: EngineData;
  lang?: SiteLang;
}

const { engine, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const siteOrigin = getSiteOrigin(Astro.site);
const absUrl = (path: string) => absoluteUrl(path, siteOrigin);
const homeHref = localizePath('/', lang);
const editorHref = localizePath(`/editor/${engine.slug}`, lang);
---

<BaseLayout title={engine.title} description={engine.description} keywords={engine.keywords}>
  <section class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-6xl">
      <nav class="mb-8 flex text-sm text-gray-500" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href={homeHref} class="transition-colors hover:text-gray-900 dark:hover:text-white">
              {t('nav.home')}
            </a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="mx-1 h-3 w-3 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"></path>
              </svg>
              <span class="ml-1 font-medium text-gray-700 dark:text-gray-300">{engine.name}</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="mb-10 text-center">
        <h1 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">
          {engine.name} Save Editor
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          Upload a compatible
          <code class="rounded bg-gray-100 px-2 py-1 text-sm dark:bg-gray-800 dark:text-gray-300">{engine.fileType}</code>
          file.
        </p>
      </div>

      <div class="min-h-[400px]">
        <EditorApp
          client:only="react"
          acceptedFileTypes={engine.fileType}
          editorSlug={engine.slug}
        />
      </div>

      <div class="prose prose-blue mt-16 max-w-none dark:prose-invert">
        <h2>How to use the RPG Maker editor</h2>
        <ol>
          {
            engine.instructions.map((step) => (
              <li>
                <Fragment set:html={step.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </li>
            ))
          }
        </ol>

        <h2>Published features</h2>
        <ul>
          {engine.features.map((feature) => <li>{feature}</li>)}
        </ul>

        <div class="not-prose mt-10 rounded-xl border border-blue-100 bg-blue-50 p-6 dark:border-blue-900/30 dark:bg-blue-950/20">
          <h3 class="mb-2 text-lg font-bold text-blue-900 dark:text-blue-400">Backup-first editing</h3>
          <p class="mb-4 text-blue-700 dark:text-blue-300">
            Keep the original save file until the edited copy loads correctly in game.
          </p>
          <a href={homeHref} class="font-medium text-blue-600 hover:underline dark:text-blue-400">
            Back to home
          </a>
        </div>
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: `${engine.name} Save Editor`,
      description: engine.description,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: engine.features,
      url: absUrl(editorHref),
      author: {
        '@type': 'Organization',
        name: 'SaveFileTool',
        url: absUrl('/'),
      },
    })}
  />
</BaseLayout>
