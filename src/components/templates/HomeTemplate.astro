---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../FAQ.astro';
import { ui, defaultLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getSiteOrigin } from '../../lib/site';
import { SMART_UPLOAD_ACCEPT } from '../../lib/saveExtensions';
import homeScriptUrl from '../../scripts/home.ts?url';

interface Props {
  lang?: keyof typeof ui;
  title: string;
  description: string;
  keywords: string;
}

const { lang = 'en', title, description, keywords } = Astro.props;
const t = useTranslations(lang);
const siteUrl = getSiteOrigin(Astro.site);
const homeUrl = lang === 'en' ? `${siteUrl}/` : `${siteUrl}/${lang}/`;

const getPath = (path: string) => {
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  if (lang === defaultLang) {
    return cleanPath ? `/${cleanPath}/` : '/';
  }
  return cleanPath ? `/${lang}/${cleanPath}/` : `/${lang}/`;
};
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(59,130,246,0.22),_transparent_40%),linear-gradient(135deg,_rgba(15,23,42,0.96),_rgba(30,41,59,0.98))]"></div>
    <div class="relative container mx-auto px-4 py-16 lg:py-24">
      <div class="mx-auto max-w-5xl text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-medium">
          <span class="h-2 w-2 rounded-full bg-green-400"></span>
          Browser-side RPG Maker save editor
        </div>

        <h1 class="mb-6 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Free Online RPG Maker Save Editor
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-lg text-slate-300 sm:text-xl">
          Edit tested <strong>.rmmzsave</strong> RPG Maker MZ save files in your browser. No installer, no server upload, backup first.
        </p>

        <div class="mx-auto mb-8 max-w-2xl">
          <div
            id="smart-upload-zone"
            class="relative cursor-pointer rounded-2xl border-2 border-dashed border-white/30 p-8 transition hover:border-primary-300 hover:bg-white/5 lg:p-12"
          >
            <input
              type="file"
              id="smart-file-input"
              class="absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0"
              accept={SMART_UPLOAD_ACCEPT}
            />
            <div class="text-center">
              <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-500 shadow-lg shadow-primary-900/40">
                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.9A5 5 0 1115.9 6H16a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
              </div>
              <p class="mb-2 text-xl font-semibold">Drop your RPG Maker save file here</p>
              <p class="text-sm text-slate-400">or click to browse</p>
              <div class="mt-4 flex flex-wrap justify-center gap-2">
                <span class="rounded bg-white/10 px-2 py-1 text-xs">.rmmzsave</span>
              </div>
            </div>
          </div>
        </div>

        <a
          href={getPath('editor/rpg-maker-mv')}
          class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
        >
          Open RPG Maker Editor
        </a>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-16">
    <div class="mx-auto max-w-6xl">
      <div class="mb-16 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-blue-100 bg-blue-50 p-6 text-center">
          <div class="text-3xl font-bold text-blue-700">1</div>
          <div class="mt-1 text-sm font-medium text-blue-900">tested extension</div>
        </div>
        <div class="rounded-xl border border-green-100 bg-green-50 p-6 text-center">
          <div class="text-3xl font-bold text-green-700">Local</div>
          <div class="mt-1 text-sm font-medium text-green-900">Browser processing</div>
        </div>
        <div class="rounded-xl border border-amber-100 bg-amber-50 p-6 text-center">
          <div class="text-3xl font-bold text-amber-700">10MB</div>
          <div class="mt-1 text-sm font-medium text-amber-900">enforced file limit</div>
        </div>
      </div>

      <div class="mb-20">
        <h2 class="mb-4 text-center text-3xl font-bold text-gray-900">How It Works</h2>
        <p class="mx-auto mb-12 max-w-xl text-center text-gray-600">
          Make a backup, edit only the values you understand, then verify the new file in game.
        </p>
        <div class="grid gap-8 text-center md:grid-cols-3">
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-blue-600 text-xl font-bold text-white">1</div>
            <h3 class="mb-3 text-xl font-bold text-gray-900">Choose Save</h3>
            <p class="text-gray-600">Select a tested RPG Maker MZ .rmmzsave file from your local game folder.</p>
          </div>
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-blue-600 text-xl font-bold text-white">2</div>
            <h3 class="mb-3 text-xl font-bold text-gray-900">Edit Values</h3>
            <p class="text-gray-600">Start with tested gold edits; treat other detected fields as candidates until verified in game.</p>
          </div>
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-blue-600 text-xl font-bold text-white">3</div>
            <h3 class="mb-3 text-xl font-bold text-gray-900">Download</h3>
            <p class="text-gray-600">Download the rebuilt file and keep your original backup until tested.</p>
          </div>
        </div>
      </div>

      <div class="mb-20 rounded-2xl bg-slate-900 p-8 text-white sm:p-12">
        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <h3 class="mb-2 text-xl font-bold">Private by default</h3>
            <p class="text-slate-300">The main editor reads and rebuilds files in your browser. Files selected on the home page are handed to the editor through browser storage, not a server endpoint.</p>
          </div>
          <div>
            <h3 class="mb-2 text-xl font-bold">RPG Maker focused</h3>
            <p class="text-slate-300">The published editor currently accepts tested RPG Maker MZ .rmmzsave files.</p>
          </div>
          <div>
            <h3 class="mb-2 text-xl font-bold">Backup-first editing</h3>
            <p class="text-slate-300">The workflow is designed for small, reversible changes rather than broad unsupported engine claims.</p>
          </div>
        </div>
      </div>

      <slot name="seo-content" />

      <section class="mt-20 border-t border-gray-100 pt-16">
        <FAQ lang={lang} />
      </section>

      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'SoftwareApplication',
          name: 'SaveFileTool RPG Maker Save Editor',
          applicationCategory: 'UtilitiesApplication',
          operatingSystem: 'Web Browser',
          offers: {
            '@type': 'Offer',
            price: '0',
            priceCurrency: 'USD',
          },
          description: 'Browser-based RPG Maker save editor for compatible local save files.',
          featureList: [
            'Tested RPG Maker MZ .rmmzsave file entry',
            'Gold and money editing with backup-first workflow',
            'Candidate field inspection for careful in-game verification',
            'Browser-side file processing',
          ],
          url: homeUrl,
          author: {
            '@type': 'Organization',
            name: 'SaveFileTool',
            url: `${siteUrl}/`,
          },
        })}
      />

      <script define:vars={{ lang }}>
        window.currentLang = lang;
      </script>
      <script type="module" src={homeScriptUrl}></script>
    </div>
  </section>
</BaseLayout>
